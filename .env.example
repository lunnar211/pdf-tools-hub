# Copy to .env.local for local development. Never commit real values.
# PLACEHOLDERS ONLY in this file. Real values live in Vercel env vars (Production).
#
# Upstash Redis rate limiting (optional; in-memory fallback is used when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
# Public site URLs (defaults are baked in if unset; the defaults below are the
# CONFIRMED live deployments, verified by curl + Vercel project state)
NEXT_PUBLIC_SITE_URL=https://pdf-tools-hub-nine-lac.vercel.app
NEXT_PUBLIC_SISTER_SITE_URL=https://ai-studio-sandy-sigma.vercel.app
NEXT_PUBLIC_LEADSFORCEGEN_URL=https://leadsforcegen.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=
#
# AdSense: set ONLY after approval; ad slot renders nothing until set
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
# Legacy premium checkout link (optional). The real Premium flow is Paddle via
# /api/checkout from the account page; set this ONLY if a separate checkout URL exists.
NEXT_PUBLIC_PREMIUM_CHECKOUT_URL=
#
# Supabase Auth (owner's EXISTING "LeadForge" project — no new project, no
# new Google Cloud OAuth client). Google provider is already configured
# there. Do NOT add GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (Auth.js is
# removed). The URL below is the public project URL (not a secret); the
# anon key is public by design, but NEVER put a real key in this file —
# placeholders only. Real values live in Vercel env vars (Production).
# Owner also adds this site's redirect URL in Supabase Dashboard →
# Authentication → URL Configuration:
#   https://pdf-tools-hub-nine-lac.vercel.app/auth/callback
NEXT_PUBLIC_SUPABASE_URL=https://omnqidmauvloedscncir.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Shared database (the SAME Supabase project, shared by PDF Tools Hub + AI
# Studio). Owner step: paste the project's POOLER connection string here
# (Vercel) for BOTH sites, and push the Prisma schema ONCE from either repo.
# Without it, tools work as guest tools and auth/account/admin show an
# honest "not configured" state.
DATABASE_URL=
#
# Admin TOTP secret key (server-only, never NEXT_PUBLIC_). Replaces the old
# Auth.js AUTH_SECRET for TOTP-secret encryption + IP-hash salt. Generate
# with: openssl rand -base64 32. To preserve existing admin TOTP setups,
# reuse the old AUTH_SECRET value here. Do NOT set AUTH_SECRET for new
# deployments (it is only a legacy fallback read during migration).
TOTP_ENCRYPTION_KEY=
# Comma-separated admin allowlist. The FIRST Google login with an allowlisted
# email becomes role ADMIN + adminRole SUPER. No passwords, no fallback login.
ADMIN_EMAILS=
#
# Paddle Billing (merchant of record). Sandbox first.
# PADDLE_ENV=sandbox until the sandbox test passes, then production.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
PADDLE_ENV=sandbox
