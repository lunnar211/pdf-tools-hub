// SHARED SCHEMA — PDF Tools Hub + AI Studio (sister site).
// This file MUST stay database-compatible in both sites. Do not rename
// models, tables, columns, or primary keys, and do not change other models'
// fields — the schema is pushed ONCE from either repo.
// One Postgres database (the owner's existing Supabase "LeadForge" project)
// is shared via the same DATABASE_URL (Supabase pooler string, set by the
// owner). Auth is Supabase Auth (Google provider configured in that
// project); the Account/Session/VerificationToken tables below are legacy
// Auth.js tables, retained untouched for shared-schema compatibility and
// unused under Supabase Auth.
// Build note: `prisma generate` runs at build (postinstall) with no DB
// connection; all runtime DB access is guarded so the site works as a guest
// tool when DATABASE_URL is unset.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AdminRole {
  SUPER
  SUPPORT
  FINANCE
}

enum Plan {
  FREE
  PREMIUM
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum JobStatus {
  SUCCESS
  FAILED
}

model User {
  id                  String     @id @default(cuid())
  // Supabase Auth user id (auth.users.id). The ONLY additive schema change
  // of the Supabase switch: maps a Supabase Auth user to its Prisma row.
  // Nullable + unique so pre-Supabase rows (email-only) keep working and
  // are linked on first Supabase login (see lib/supabase/server.ts).
  supabaseId          String?    @unique
  email               String     @unique
  name                String?
  image               String?
  role                Role       @default(USER)
  adminRole           AdminRole?
  plan                Plan       @default(FREE)
  status              UserStatus @default(ACTIVE)
  country             String?
  dateOfBirth         DateTime?
  ageConfirmed        Boolean    @default(false)
  ageConfirmedAt      DateTime?
  termsAcceptedAt     DateTime?
  totpEnabled         Boolean    @default(false)
  totpSecretEncrypted String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastLoginAt         DateTime?

  accounts      Account[]
  sessions      Session[]
  jobs          Job[]
  subscriptions Subscription[]
  payments      Payment[]
  notes         AdminNote[] @relation("UserNotes")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id           String    @id @default(cuid())
  userId       String?
  tool         String
  status       JobStatus
  inputSummary String?
  errorCode    String?
  costEstimate Float?
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tool, createdAt])
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String
  provider         String   @default("PADDLE")
  customerId       String
  subscriptionId   String   @unique
  plan             Plan
  status           String
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  provider      String   @default("PADDLE")
  transactionId String   @unique
  invoiceId     String?
  amount        Int
  currency      String
  status        String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  note      String
  createdAt DateTime @default(now())

  user User @relation("UserNotes", fields: [userId], references: [id], onDelete: Cascade)
}

model BlockedIp {
  id        String    @id @default(cuid())
  ipHash    String    @unique
  reason    String?
  blockedBy String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model SiteSetting {
  key   String @id
  value String
}

model Expense {
  id        String   @id @default(cuid())
  category  String
  vendor    String
  amount    Int
  currency  String
  date      DateTime
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
}

model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN")
  reply     String?
  repliedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String    @unique
  eventType   String
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
