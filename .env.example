# Copy to .env.local for local development. Never commit real values.
# Upstash Redis rate limiting (optional; in-memory fallback is used when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Public site URLs (defaults are baked in if unset)
NEXT_PUBLIC_SITE_URL=https://pdf-tools-hub.vercel.app
NEXT_PUBLIC_SISTER_SITE_URL=https://ai-studio.vercel.app
NEXT_PUBLIC_LEADSFORCEGEN_URL=https://leadsforcegen.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=
# AdSense: set ONLY after approval; ad slot renders nothing until set
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
# Premium checkout: set ONLY when a real checkout URL exists; otherwise no actionable button renders
NEXT_PUBLIC_PREMIUM_CHECKOUT_URL=
